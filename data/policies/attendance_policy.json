{
  "policy_id": "HR-ATTEND-001",
  "name": "Employee Attendance Policy",
  "version": "1.0",
  "standard_start_time": "09:00",
  "standard_end_time": "17:30",
  "late_grace_minutes": 10,
  "thresholds": {
    "min_attendance_percentage_normal": 90.0,
    "min_attendance_percentage_warning": 80.0,
    "late_arrival_warning_count": 5,
    "consecutive_absence_escalation": 3,
    "missing_records_blocked": 3,
    "early_departure_warning_count": 3
  },
  "severity": {
    "normal": "recommend",
    "warning": "approve",
    "escalation": "escalate",
    "blocked": "blocked"
  },
  "rules": {
    "employee_must_be_active": true,
    "attendance_percentage_uses_expected_working_days": true,
    "present_statuses": ["present", "late", "early_departure"],
    "late_statuses": ["late"],
    "absent_statuses": ["absent"],
    "escalation_requires_human_approval": true,
    "warning_allows_notify_and_review": true,
    "no_automatic_disciplinary_action": true,
    "hr_review_role": "hr_admin",
    "manager_review_role": "manager"
  }
}
