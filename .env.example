GOOGLE_API_KEY=
GEMINI_MODEL=
APP_ENV=development
APP_VERSION=0.7.0
API_V1_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT — set a strong secret outside development. Never commit real secrets.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (Module 5C) — placeholder only; never commit real credentials.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/enterprise_workflow
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
