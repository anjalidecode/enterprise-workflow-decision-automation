GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional. Gemini request timeout in seconds (structured JSON can exceed 20s).
LLM_TIMEOUT_SECONDS=60
# Gemini is optional. Leave GOOGLE_API_KEY empty for deterministic local operation.
# Never expose GOOGLE_API_KEY to the frontend.
APP_ENV=development
APP_VERSION=0.8.0
API_V1_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT — set a strong secret outside development. Never commit real secrets.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (Module 5C) — placeholder only; never commit real credentials.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/enterprise_workflow
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Frontend base URL used in email links (login, activation, approvals).
# Change this for staging/production deployments.
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Email notifications (Module 5G)
# Development (default): console provider prints safe email previews — no SMTP required.
EMAIL_PROVIDER=console
# Real delivery: set EMAIL_PROVIDER=smtp and fill SMTP_* below. Never commit real secrets.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=WorkSphere AI
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WorkSphere AI
SMTP_USE_TLS=true
